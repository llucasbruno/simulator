<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Invitational — TL Simulator</title>
    <script type="module" src="db.js"></script>
    <script src="shared.js"></script>
    <script type="module" src="navbar.js"></script>
    <style>
        :root {
            --bg:        #07080a;
            --bg2:       #0d0f14;
            --bg3:       #12151c;
            --border:    rgba(255,255,255,0.06);
            --gold:      #d4a84b;
            --gold2:     #f0c96a;
            --liquid:    #00aeff;
            --red:       #ff4655;
            --green:     #42f590;
            --text:      #e8eaf0;
            --muted:     #5a6070;
            --amer:      #ff5e00;
            --emea:      #00aeff;
            --pac:       #a855f7;
            --cn:        #ef4444;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0a0c10; }
        ::-webkit-scrollbar-thumb { background: #1e2535; border-radius: 3px; }

        /* ── HERO ─────────────────────────────────────────────────────── */
        .gi-hero {
            background: radial-gradient(ellipse at 50% -20%, rgba(212,168,75,0.12) 0%, transparent 60%),
                        linear-gradient(180deg, #0d0f14 0%, #07080a 100%);
            border-bottom: 1px solid rgba(212,168,75,0.15);
            padding: 60px 24px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .gi-hero::before {
            content: 'GLOBAL INVITATIONAL';
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%,-50%);
            font-size: 12rem; font-weight: 900; letter-spacing: -0.02em;
            color: rgba(212,168,75,0.03);
            white-space: nowrap; pointer-events: none; user-select: none;
        }

        .gi-trophy { font-size: 3rem; margin-bottom: 12px; filter: drop-shadow(0 0 20px rgba(212,168,75,0.4)); }

        .gi-hero h1 {
            font-size: clamp(1.8rem, 4vw, 3.2rem);
            font-weight: 900; letter-spacing: 4px; text-transform: uppercase;
            color: var(--gold);
        }

        .gi-hero h1 span { color: rgba(255,255,255,0.35); font-size: 0.55em; display: block; letter-spacing: 6px; margin-bottom: 4px; }

        .gi-subtitle {
            margin-top: 10px; font-size: 0.8rem; color: var(--muted);
            letter-spacing: 2px; text-transform: uppercase;
        }

        .gi-status-bar {
            display: flex; align-items: center; justify-content: center;
            gap: 24px; margin-top: 24px; flex-wrap: wrap;
        }

        .gi-pill {
            background: rgba(255,255,255,0.04); border: 1px solid var(--border);
            border-radius: 20px; padding: 6px 16px;
            font-size: 0.72rem; color: var(--muted); letter-spacing: 1px;
            display: flex; align-items: center; gap: 6px;
        }

        .gi-pill strong { color: var(--gold); font-family: monospace; }

        /* ── CONTROLS ─────────────────────────────────────────────────── */
        .controls {
            display: flex; flex-wrap: wrap; gap: 10px;
            justify-content: center; padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            background: var(--bg2);
            position: sticky; top: 52px; z-index: 100;
        }

        button {
            padding: 9px 20px; border: 1px solid var(--border);
            background: var(--bg3); color: #888;
            font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px;
            text-transform: uppercase; cursor: pointer;
            transition: all 0.2s; border-radius: 3px;
        }

        button:hover { border-color: #444; color: var(--text); }
        button:disabled { opacity: 0.35; cursor: not-allowed; }

        .btn-primary { background: linear-gradient(135deg,#1a2a1a,#0f1f0f); border-color: var(--green); color: var(--green); }
        .btn-primary:hover { box-shadow: 0 0 20px rgba(66,245,144,0.2); }
        .btn-danger  { border-color: #500; color: #a33; }
        .btn-danger:hover { border-color: var(--red); color: var(--red); }
        .btn-gold    { background: linear-gradient(135deg,#1a1400,#2a2000); border-color: var(--gold); color: var(--gold); }

        /* ── PHASE DISPLAY ────────────────────────────────────────────── */
        .phase-display {
            text-align: center; padding: 12px;
            font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase;
            color: var(--gold); border-bottom: 1px solid rgba(212,168,75,0.1);
        }

        /* ── GROUPS GRID ──────────────────────────────────────────────── */
        .groups-wrap {
            max-width: 1300px; margin: 0 auto;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px; padding: 20px 16px;
        }

        .group-card {
            background: var(--bg2); border: 1px solid var(--border);
            border-radius: 8px; overflow: hidden;
        }

        .group-header {
            background: linear-gradient(90deg, rgba(212,168,75,0.08), transparent);
            border-bottom: 1px solid rgba(212,168,75,0.1);
            padding: 10px 14px;
            display: flex; justify-content: space-between; align-items: center;
        }

        .group-header h3 { font-size: 0.82rem; letter-spacing: 2px; color: var(--gold); }
        .group-header span { font-size: 0.65rem; color: var(--muted); font-family: monospace; }

        table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
        th { padding: 7px 10px; text-align: left; font-size: 0.62rem; color: var(--muted);
             text-transform: uppercase; letter-spacing: 1px; font-weight: normal;
             border-bottom: 1px solid var(--border); }
        td { padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,0.03); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .team-row.qualified-row td { background: rgba(66,245,144,0.04); }
        .team-row.manual-row td { background: rgba(0,174,255,0.04); }

        .reg-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
        .reg-AMER { background: var(--amer); }
        .reg-EMEA { background: var(--emea); }
        .reg-PAC  { background: var(--pac);  }
        .reg-CN   { background: var(--cn);   }

        .team-logo-sm { width: 18px; height: 18px; object-fit: contain; vertical-align: middle; margin-right: 5px; }
        .pts { font-family: monospace; font-weight: bold; color: var(--text); }
        .wr  { font-family: monospace; font-size: 0.68rem; color: var(--muted); }

        .qual-badge { font-size: 0.55rem; background: rgba(66,245,144,0.15);
                      border: 1px solid rgba(66,245,144,0.3); color: var(--green);
                      padding: 1px 5px; border-radius: 2px; margin-left: 4px; }

        /* Destino / cenário cols */
        .fate-direct   { color: var(--green);  font-size: 0.65rem; }
        .fate-open     { color: #ffd700;        font-size: 0.65rem; }
        .fate-risk     { color: #ff9d00;        font-size: 0.65rem; }
        .fate-elim     { color: var(--red);     font-size: 0.65rem; }
        .fate-lock     { color: var(--green);   font-size: 0.65rem; }

        .chance-bar { display: inline-block; width: 50px; height: 4px; background: #111;
                      border-radius: 2px; overflow: hidden; vertical-align: middle; margin-left: 5px; }
        .chance-fill { height: 100%; border-radius: 2px; }

        /* ── BRACKET ──────────────────────────────────────────────────── */
        .bracket-wrap {
            max-width: 1300px; margin: 0 auto; padding: 20px 16px;
            display: flex; gap: 16px; overflow-x: auto;
        }

        .bracket-col { display: flex; flex-direction: column; gap: 12px; min-width: 200px; }

        .bracket-col-header {
            text-align: center; font-size: 0.65rem; letter-spacing: 2px;
            text-transform: uppercase; color: var(--muted); padding: 8px 0;
            border-bottom: 1px solid var(--border);
        }

        .bracket-match {
            background: var(--bg2); border: 1px solid var(--border);
            border-radius: 6px; overflow: hidden;
            transition: border-color 0.2s;
        }

        .bracket-match.active-match { border-color: var(--gold); }
        .bracket-match.has-tl       { border-color: var(--liquid); }

        .bracket-team {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 10px; font-size: 0.78rem;
            border-bottom: 1px solid var(--border);
        }

        .bracket-team:last-child { border-bottom: none; }
        .bracket-team.winner-team { color: var(--gold); font-weight: bold; }
        .bracket-team.empty-team  { color: var(--muted); font-style: italic; }

        .bracket-score {
            margin-left: auto; font-family: monospace; font-size: 0.75rem;
            font-weight: bold;
        }

        .bracket-match .score-row {
            font-size: 0.62rem; color: var(--muted); text-align: center;
            padding: 3px; background: rgba(0,0,0,0.2);
        }

        /* ── LOG ──────────────────────────────────────────────────────── */
        .log-wrap {
            max-width: 1300px; margin: 0 auto; padding: 0 16px 20px;
        }

        .log-title {
            font-size: 0.65rem; letter-spacing: 2px; text-transform: uppercase;
            color: var(--muted); padding: 12px 0 8px;
            border-bottom: 1px solid var(--border); margin-bottom: 8px;
        }

        .log-entry {
            font-size: 0.72rem; padding: 5px 0;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            color: #555;
        }

        .log-entry.tl-log { color: var(--liquid); }
        .log-detail { font-size: 0.64rem; color: #333; margin-top: 2px; }

        /* ── MODAL ────────────────────────────────────────────────────── */
        .modal-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.85); backdrop-filter: blur(6px);
            z-index: 9000; align-items: center; justify-content: center;
        }

        .modal-content {
            background: var(--bg2); border: 1px solid rgba(212,168,75,0.2);
            border-radius: 10px; padding: 28px 32px; width: 100%; max-width: 480px;
            position: relative; max-height: 90vh; overflow-y: auto;
        }

        .modal-close {
            position: absolute; top: 14px; right: 18px;
            background: none; border: none; color: var(--muted);
            font-size: 1.4rem; cursor: pointer; padding: 0; min-width: unset;
        }

        .modal-close:hover { color: var(--text); }

        .modal-matchup {
            display: flex; align-items: center; justify-content: center;
            gap: 20px; margin: 12px 0 20px;
        }

        .modal-team { text-align: center; }
        .modal-team img { width: 48px; height: 48px; object-fit: contain; margin: 0 auto 6px; display: block; }
        .modal-team .name { font-weight: bold; font-size: 0.85rem; }
        .modal-team .elo  { font-size: 0.68rem; color: var(--muted); font-family: monospace; }
        .modal-vs { font-size: 1.6rem; font-weight: 900; color: var(--gold); opacity: 0.5; }

        .modal-warn {
            background: rgba(255,157,0,0.08); border: 1px solid rgba(255,157,0,0.2);
            border-radius: 4px; padding: 6px 10px; font-size: 0.7rem;
            color: #ff9d00; text-align: center; margin-bottom: 14px;
        }

        .map-row {
            display: flex; align-items: center; justify-content: center;
            gap: 10px; margin-bottom: 10px;
        }

        .map-row label { font-size: 0.7rem; color: var(--muted); width: 50px; text-align: right; }

        .map-row input {
            width: 60px; background: var(--bg3); border: 1px solid var(--border);
            color: var(--text); padding: 6px 8px; text-align: center;
            font-size: 0.9rem; border-radius: 3px; font-family: monospace;
        }

        .map-row input:focus { outline: none; border-color: var(--gold); }
        .map-sep { color: var(--muted); font-size: 1.2rem; }

        .elo-preview {
            display: none; background: rgba(0,0,0,0.3); border: 1px solid var(--border);
            border-radius: 4px; padding: 8px; text-align: center;
            font-family: monospace; font-size: 0.78rem; margin: 10px 0;
        }

        .btn-confirm {
            width: 100%; margin-top: 14px; background: linear-gradient(135deg,#1a2a1a,#0f1f0f);
            border-color: var(--green); color: var(--green); padding: 12px;
            font-size: 0.78rem;
        }

        /* ── PROGRESS ─────────────────────────────────────────────────── */
        .progress-bar { height: 2px; background: var(--border); }
        .progress-fill { height: 100%; background: var(--gold); transition: width 0.4s; }

        /* ── LOADING ──────────────────────────────────────────────────── */
        #loadingOverlay {
            position: fixed; inset: 0; background: var(--bg);
            z-index: 9999; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 14px;
        }

        @keyframes pulse { 0%,100%{opacity:.3} 50%{opacity:1} }
        #loadingOverlay img { width: 56px; animation: pulse 1.2s ease-in-out infinite; }
        #loadingOverlay span { font-size: 0.72rem; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }

        /* ── SETUP MODAL ─────────────────────────────────────────────── */
        .setup-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 12px; }

        .team-pick {
            display: flex; align-items: center; gap: 8px;
            background: var(--bg3); border: 1px solid var(--border);
            border-radius: 5px; padding: 7px 10px; cursor: pointer;
            transition: all 0.15s;
        }

        .team-pick.selected { border-color: var(--gold); background: rgba(212,168,75,0.08); }
        .team-pick.locked   { border-color: var(--liquid); background: rgba(0,174,255,0.06); cursor: default; }
        .team-pick img { width: 20px; height: 20px; object-fit: contain; }
        .team-pick span { font-size: 0.75rem; }

        .section-lbl {
            font-size: 0.62rem; letter-spacing: 2px; text-transform: uppercase;
            color: var(--muted); margin: 14px 0 6px;
            padding-bottom: 4px; border-bottom: 1px solid var(--border);
        }
    </style>
</head>
<body>

<!-- Loading -->
<div id="loadingOverlay">
    <img src="https://am-a.akamaihd.net/image?resize=3840:&f=http%3A%2F%2Fstatic.lolesports.com%2Fteams%2F1637252586938_teamliquid.png" alt="TL">
    <span>Carregando dados...</span>
</div>

<!-- Hero -->
<div class="gi-hero">
    <div class="gi-trophy">🌍</div>
    <h1><span>VCT</span>Global Invitational</h1>
    <div class="gi-subtitle">24 times · 4 regiões · 1 campeão</div>
    <div class="gi-status-bar">
        <div class="gi-pill">EMEA <strong id="heroRegion">—</strong></div>
        <div class="gi-pill">ELO TL <strong id="heroElo">—</strong></div>
        <div class="gi-pill">Fase <strong id="heroPhase">—</strong></div>
    </div>
    <div class="progress-bar" style="margin-top:20px;"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
</div>

<!-- Controls -->
<div class="controls">
    <button class="btn-primary" id="btnPlay" onclick="gi.playRound()">⚔ PRÓXIMA BATALHA</button>
    <button id="btnReopenModal" style="display:none;border-color:#ff9d00;color:#ff9d00;" onclick="gi.openModal(gi.manualMatchPending,gi.manualMatchPending?.bestOf||3)">🎮 INSERIR RESULTADO TL</button>
    <button class="btn-gold" onclick="gi.openSetup()">✦ NOVO TORNEIO</button>
    <button onclick="gi.openCareerModal()">⚡ CARREIRA</button>
    <button class="btn-danger" onclick="gi.wipe()">WIPE</button>
</div>

<div id="phaseLabel" class="phase-display"></div>

<!-- Main display -->
<div id="mainDisplay"></div>

<!-- Log -->
<div class="log-wrap"><div class="log-title">Histórico de Partidas</div><div id="gameLog"></div></div>

<!-- Manual Match Modal -->
<div id="manualModal" class="modal-overlay">
    <div class="modal-content">
        <button class="modal-close" onclick="gi.closeModal()">×</button>
        <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">TEAM LIQUID — INSERIR RESULTADO</div>
        <div class="modal-warn">⚠ Preencha o resultado antes de avançar</div>
        <div class="modal-matchup" id="modalMatchup"></div>
        <div id="mapsContainer"></div>
        <div class="elo-preview" id="eloPreview"><span id="eloPreviewText"></span></div>
        <button class="btn-confirm" onclick="gi.confirmManualMatch()">✓ CONFIRMAR RESULTADO</button>
    </div>
</div>

<!-- Career Modal -->
<div id="careerModal" class="modal-overlay">
    <div class="modal-content" style="max-width:820px;">
        <button class="modal-close" onclick="document.getElementById('careerModal').style.display='none'">×</button>
        <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;">TEAM LIQUID — CARREIRA</div>
        <div style="display:flex;gap:8px;margin-bottom:16px;">
            <button onclick="gi.switchCareerTab('overview',this)" style="border-color:var(--gold);color:var(--gold)" class="career-active">Visão Geral</button>
            <button onclick="gi.switchCareerTab('history',this)">Histórico</button>
            <button onclick="gi.switchCareerTab('h2h',this)">H2H</button>
        </div>
        <div id="careerBody" style="min-height:300px;max-height:55vh;overflow-y:auto;"></div>
    </div>
</div>

<!-- Setup Modal -->
<div id="setupModal" class="modal-overlay">
    <div class="modal-content" style="max-width:700px;">
        <button class="modal-close" onclick="document.getElementById('setupModal').style.display='none'">×</button>
        <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">NOVO GLOBAL INVITATIONAL</div>
        <div style="font-size:0.8rem;color:var(--muted);margin-bottom:12px;">Selecione 6 times por região (24 no total). Team Liquid é obrigatório.</div>
        <div id="setupBody"></div>
        <button class="btn-gold" onclick="gi.startTournament()" style="width:100%;margin-top:16px;padding:12px;">✦ INICIAR TORNEIO</button>
    </div>
</div>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// GI_KEY: chave de save do Global Invitational
// ─────────────────────────────────────────────────────────────────────────────
const GI_KEY = 'global_invitational_v1';

// Times padrão por região (top 6)
const GI_DEFAULT = {
    AMER: ['NRG','SEN','LOUD','LEV','100T','C9'],
    EMEA: ['Team Liquid','FNC','NAVI','TH','VIT','KC'],
    PAC:  ['PRX','DRX','GEN','T1','TS','ZETA'],
    CN:   ['EDG','BLG','FPX','TE','DRG','WOL'],
};

const K_GROUPS = 49, K_QF = 63, K_SF = 79, K_FINAL = 107;

function giKFactor(phase) {
    return { GROUPS:K_GROUPS, QUARTERS:K_QF, SEMIS:K_SF, FINAL:K_FINAL }[phase] || K_GROUPS;
}

class GlobalInvitational {
    constructor() {
        this.teams            = [];
        this.groups           = {};       // { A:[…], B:[…], C:[…], D:[…] }
        this.schedule         = [];       // partidas de grupos
        this.currentGroupRound = 1;
        this.knockoutMatches  = [];
        this.currentPhase     = 'IDLE';  // IDLE | GROUPS | QUARTERS | SEMIS | FINAL | FINISHED
        this.historyLogs      = [];
        this.tlStats          = DB.load(TL_STATS_KEY) || { matches:[], eloHistory:[], headToHead:{} };
        this.legacyStats      = DB.load(ELO_KEY)      || {};
        this.manualMatchPending = null;
        this._load();
    }

    // ── Persistence ────────────────────────────────────────────────────────
    _load() {
        const saved = DB.load(GI_KEY);
        if (!saved) return;
        this.teams            = (saved.teams || []).map(t => this._hydrate(t));
        this.groups           = this._hydrateGroups(saved.groups || {});
        this.schedule         = (saved.schedule || []).map(m => this._hydrateMatch(m));
        this.knockoutMatches  = (saved.knockoutMatches || []).map(m => this._hydrateMatch(m));
        this.currentGroupRound = saved.currentGroupRound || 1;
        this.currentPhase     = saved.currentPhase || 'IDLE';
        this.historyLogs      = saved.historyLogs  || [];
    }

    _hydrate(t) {
        const leg = this.legacyStats[t.name] || {};
        return { ...t, rating: leg.elo ?? t.rating ?? 0, logo: leg.logo || t.logo || DEFAULT_LOGO };
    }

    _hydrateGroups(g) {
        const out = {};
        Object.keys(g).forEach(k => { out[k] = (g[k] || []).map(t => this._hydrate(t)); });
        return out;
    }

    _hydrateMatch(m) {
        const t1 = m.t1 ? this.teams.find(t => t.name === m.t1.name) || m.t1 : null;
        const t2 = m.t2 ? this.teams.find(t => t.name === m.t2.name) || m.t2 : null;
        const winner = m.winner ? (this.teams.find(t => t.name === m.winner.name) || m.winner) : null;
        return { ...m, t1, t2, winner };
    }

    save() {
        DB.save(GI_KEY, {
            teams:           this.teams.map(t=>({name:t.name,region:t.region,logo:t.logo,rating:t.rating,wins:t.wins||0,losses:t.losses||0,points:t.points||0,qualified:t.qualified||false,isManual:t.isManual||false})),
            groups:          Object.fromEntries(Object.entries(this.groups).map(([k,v])=>[k,v.map(t=>({name:t.name}))])),
            schedule:        this.schedule.map(m=>({...m,t1:{name:m.t1?.name},t2:{name:m.t2?.name},winner:m.winner?{name:m.winner.name}:null})),
            knockoutMatches: this.knockoutMatches.map(m=>({...m,t1:m.t1?{name:m.t1.name}:null,t2:m.t2?{name:m.t2.name}:null,winner:m.winner?{name:m.winner.name}:null})),
            currentGroupRound: this.currentGroupRound,
            currentPhase:    this.currentPhase,
            historyLogs:     this.historyLogs.slice(0,100),
        });
    }

    saveTL() { DB.save(TL_STATS_KEY, this.tlStats); }

    saveGlobal(team) {
        this.legacyStats[team.name] = { elo: team.rating, logo: team.logo, wins: team.wins||0, losses: team.losses||0 };
        DB.save(ELO_KEY, this.legacyStats);
    }

    // ── Setup ───────────────────────────────────────────────────────────────
    openSetup() {
        const body = document.getElementById('setupBody');
        body.innerHTML = '';
        ['AMER','EMEA','PAC','CN'].forEach(region => {
            const regionTeams = REAL_TEAMS_DATA.filter(t => t.region === region);
            const defaults    = GI_DEFAULT[region];
            body.innerHTML += `<div class="section-lbl"><span class="reg-dot reg-${region}"></span>${region} — selecione 6 times</div>
            <div class="setup-grid" id="setup_${region}">
                ${regionTeams.map(t => {
                    const locked = t.name === 'Team Liquid';
                    const sel    = defaults.includes(t.name);
                    return `<div class="team-pick ${sel?'selected':''} ${locked?'locked':''}" data-name="${t.name}" data-region="${region}" onclick="gi._togglePick(this)">
                        <img src="${t.logo||DEFAULT_LOGO}" alt="${t.name}">
                        <span>${t.name}</span>
                    </div>`;
                }).join('')}
            </div>`;
        });
        document.getElementById('setupModal').style.display = 'flex';
    }

    _togglePick(el) {
        if (el.classList.contains('locked')) return;
        const region = el.dataset.region;
        const grid   = document.getElementById(`setup_${region}`);
        const selected = grid.querySelectorAll('.selected:not(.locked)').length;
        if (el.classList.contains('selected')) {
            el.classList.remove('selected');
        } else {
            if (selected >= 5) { alert(`Já selecionou 6 times no ${region}. Remova um antes.`); return; }
            el.classList.add('selected');
        }
    }

    startTournament() {
        // Coleta times selecionados por região
        const selected = {};
        ['AMER','EMEA','PAC','CN'].forEach(region => {
            const picks = [...document.querySelectorAll(`#setup_${region} .selected`)].map(el => el.dataset.name);
            if (picks.length !== 6) { alert(`Selecione exatamente 6 times na região ${region} (atual: ${picks.length})`); throw new Error('invalid'); }
            selected[region] = picks;
        });

        // Monta os 24 times
        this.teams = [];
        Object.entries(selected).forEach(([region, names]) => {
            names.forEach(name => {
                const data = REAL_TEAMS_DATA.find(t => t.name === name);
                const leg  = this.legacyStats[name] || {};
                this.teams.push({
                    name, region,
                    logo:     leg.logo  || data?.logo  || DEFAULT_LOGO,
                    rating:   leg.elo   ?? 0,
                    wins:     leg.wins  ?? 0,
                    losses:   leg.losses ?? 0,
                    points:   0, qualified: false,
                    isManual: name === 'Team Liquid',
                    status:   'neutral',
                });
            });
        });

        // Seed groups: distribui 1 de cada região por grupo (6 grupos de 4... wait 4 grupos de 6)
        // 4 grupos de 6: cada grupo recebe 1-2 times de cada região balanceado
        this._seedGroups();
        this._generateGroupSchedule();
        this.knockoutMatches  = [];
        this.currentGroupRound = 1;
        this.currentPhase     = 'GROUPS';
        this.historyLogs      = [];

        document.getElementById('setupModal').style.display = 'none';
        this.save();
        this.render();
        this.updateButtons();
    }

    _seedGroups() {
        // 4 grupos de 6 times
        // Distribui 1-2 por região em cada grupo
        const regionTeams = { AMER:[], EMEA:[], PAC:[], CN:[] };
        this.teams.forEach(t => regionTeams[t.region].push(t));

        // Ordena cada região por ELO desc para seeding
        Object.values(regionTeams).forEach(arr => arr.sort((a,b) => (b.rating||0)-(a.rating||0)));

        const groupKeys = ['A','B','C','D'];
        this.groups = { A:[], B:[], C:[], D:[] };

        // Serpentine seeding: distribui 6 times de cada região pelos 4 grupos
        // Resultado: cada grupo terá 1-2 times de cada região
        const allSorted = [];
        // Intercala regiões: A1,B1,C1,D1, A2,B2,C2,D2, A3,B3,C3,D3, ...
        for (let i = 0; i < 6; i++) {
            ['AMER','EMEA','PAC','CN'].forEach(r => {
                if (regionTeams[r][i]) allSorted.push({ ...regionTeams[r][i], region: r });
            });
        }

        // Distribui 6 por grupo
        allSorted.forEach((t, idx) => {
            const g = groupKeys[idx % 4];
            this.groups[g].push(this.teams.find(x => x.name === t.name));
        });
    }

    _generateGroupSchedule() {
        this.schedule = [];
        let round = 1;
        Object.keys(this.groups).forEach(g => {
            const teams = this.groups[g];
            const n = teams.length; // 6
            // Circle method para 6 times: 5 rodadas, 3 jogos por rodada
            const pool = [...teams];
            for (let r = 0; r < n - 1; r++) {
                for (let i = 0; i < n/2; i++) {
                    this.schedule.push({ group:g, round:r+1, t1:pool[i], t2:pool[n-1-i], played:false, winner:null, score:null });
                }
                // Rota: fixo pool[0], rotaciona o resto
                const last = pool.pop();
                pool.splice(1, 0, last);
            }
        });
    }

    // ── Play ────────────────────────────────────────────────────────────────
    playRound() {
        if (this.manualMatchPending) { this.openModal(this.manualMatchPending, 3); return; }
        if (this.currentPhase === 'GROUPS') this._runGroupRound();
        else if (['QUARTERS','SEMIS','FINAL'].includes(this.currentPhase)) this._runKO();
    }

    _runGroupRound() {
        const pending = this.schedule.filter(m => m.round === this.currentGroupRound && !m.played);
        if (pending.length === 0) {
            // Avança rodada
            const maxRound = Math.max(...this.schedule.map(m=>m.round));
            if (this.currentGroupRound < maxRound) {
                this.currentGroupRound++;
                this.save(); this.render(); this.updateButtons();
                return;
            } else {
                this._advanceToKO(); return;
            }
        }
        const manual = pending.find(m => m.t1?.isManual || m.t2?.isManual);
        if (manual) {
            pending.forEach(m => { if (m !== manual) this._simMatch(m, 3); });
            this.save();
            localStorage.setItem('gi_pending_tl', JSON.stringify({ t1: manual.t1.name, t2: manual.t2.name, round: this.currentGroupRound }));
            this.manualMatchPending = manual;
            this.openModal(manual, 3);
        } else {
            pending.forEach(m => this._simMatch(m, 3));
            this.save(); this.render(); this.updateButtons();
        }
    }

    _runKO() {
        const unplayed = this.knockoutMatches.filter(m => m.phase === this.currentPhase && !m.played && m.t1 && m.t2);
        if (unplayed.length === 0) { this._advanceKOPhase(); return; }
        const bestOf  = this.currentPhase === 'FINAL' ? 5 : 3;
        const manual  = unplayed.find(m => m.t1?.isManual || m.t2?.isManual);
        if (manual) {
            const idx = unplayed.indexOf(manual);
            for (let i=0; i<idx; i++) this._simMatch(unplayed[i], bestOf);
            this.save();
            this.manualMatchPending = manual;
            this.openModal(manual, bestOf);
        } else {
            unplayed.forEach(m => this._simMatch(m, bestOf));
            this.save(); this.render(); this.updateButtons();
        }
    }

    _simMatch(match, bestOf) {
        const { winner, loser, score, maps } = simSeries(match.t1, match.t2, bestOf);
        this._resolveStats(winner, loser, score, maps, match);
    }

    _resolveStats(winner, loser, score, maps, match) {
        const K = giKFactor(this.currentPhase);
        const { gain, loss, chance } = calcElo(winner.rating, loser.rating, K);
        winner.rating = Math.max(0, winner.rating + gain);
        loser.rating  = Math.max(0, loser.rating  - loss);
        winner.wins   = (winner.wins || 0) + 1;
        loser.losses  = (loser.losses || 0) + 1;
        if (this.currentPhase === 'GROUPS') { winner.points = (winner.points||0) + 3; }
        match.played = true; match.winner = winner; match.score = score;
        this.saveGlobal(winner); this.saveGlobal(loser);

        const mapsStr = maps.map(m => `[${m.sW}-${m.sL}]`).join(' ');
        const last    = maps[maps.length-1];
        const flavor  = last.sW-last.sL>8 ? 'MASSACRE' : last.sW>13 ? 'OVERTIME' : '';

        this.historyLogs.unshift({
            text:   `${winner.name} ${score} ${loser.name}`,
            detail: `${mapsStr} | K${K} | ${chance}% → +${gain}/-${loss} ${flavor}`,
            tl:     winner.isManual || loser.isManual,
        });

        // TL career tracking
        if (winner.isManual || loser.isManual) {
            const tl  = winner.isManual ? winner : loser;
            const opp = winner.isManual ? loser  : winner;
            const won = winner.isManual;
            if (!this.tlStats.headToHead[opp.name]) this.tlStats.headToHead[opp.name] = { wins:0, losses:0, logo:opp.logo };
            if (won) this.tlStats.headToHead[opp.name].wins++; else this.tlStats.headToHead[opp.name].losses++;
            this.tlStats.matches.push({ opponent:opp.name, oppLogo:opp.logo, result:won?'W':'L', score, phase:`GI — ${this.currentPhase}`, season:'GI', eloChange:won?gain:-loss, eloAfter:tl.rating, date:new Date().toLocaleDateString('pt-BR'), maps:mapsStr });
            this.tlStats.eloHistory.push({ elo:tl.rating, season:'GI', phase:this.currentPhase, date:new Date().toLocaleDateString('pt-BR') });
            this.saveTL();
        }
    }

    // ── Advance ─────────────────────────────────────────────────────────────
    _advanceToKO() {
        // Top 2 por grupo → Quartas (8 times)
        const qualifiers = [];
        ['A','B','C','D'].forEach(g => {
            const sorted = [...this.groups[g]].sort((a,b) => b.points-a.points||b.wins-a.wins||b.rating-a.rating);
            sorted[0].qualified = true; sorted[1].qualified = true;
            qualifiers.push(sorted[0], sorted[1]);
        });

        // Quartas: A1vsD2, B1vsC2, C1vsB2, D1vsA2
        const [a1,a2, b1,b2, c1,c2, d1,d2] = qualifiers;
        this.knockoutMatches = [
            { phase:'QUARTERS', t1:a1, t2:d2, played:false, winner:null, score:null, nextMatchIdx:4 },
            { phase:'QUARTERS', t1:b1, t2:c2, played:false, winner:null, score:null, nextMatchIdx:5 },
            { phase:'QUARTERS', t1:c1, t2:b2, played:false, winner:null, score:null, nextMatchIdx:5 },
            { phase:'QUARTERS', t1:d1, t2:a2, played:false, winner:null, score:null, nextMatchIdx:4 },
            { phase:'SEMIS', t1:null, t2:null, played:false, winner:null, score:null, nextMatchIdx:6 },
            { phase:'SEMIS', t1:null, t2:null, played:false, winner:null, score:null, nextMatchIdx:6 },
            { phase:'FINAL', t1:null, t2:null, played:false, winner:null, score:null, nextMatchIdx:null },
        ];
        this.currentPhase = 'QUARTERS';
        this.save(); this.render(); this.updateButtons();
    }

    _advanceKOPhase() {
        // Propaga vencedores
        this.knockoutMatches.forEach(m => {
            if (m.phase === this.currentPhase && m.played && m.winner && m.nextMatchIdx !== null) {
                const next = this.knockoutMatches[m.nextMatchIdx];
                if (next) { if (!next.t1) next.t1 = m.winner; else if (!next.t2) next.t2 = m.winner; }
            }
        });
        const order = ['QUARTERS','SEMIS','FINAL'];
        const idx   = order.indexOf(this.currentPhase);
        if (this.currentPhase === 'FINAL') { this._finish(); return; }
        this.currentPhase = order[idx+1] || 'FINAL';
        this.save(); this.render(); this.updateButtons();
    }

    _finish() {
        const final   = this.knockoutMatches.find(m => m.phase === 'FINAL');
        const champion = final?.winner;
        this.currentPhase = 'FINISHED';
        if (champion) {
            champion.rating += 150; // bônus campeão
            this.saveGlobal(champion);
            if (champion.isManual) {
                const trophies = DB.load(TROPHY_KEY) || [];
                trophies.push({ type:'CHAMPIONS', icon:'🌍', title:'Global Invitational', date:new Date().toLocaleDateString('pt-BR'), runnerUp:'—' });
                DB.save(TROPHY_KEY, trophies);
            }
            alert(`🏆 CAMPEÃO: ${champion.name}!\n+150 ELO de bônus!`);
        }
        this.save(); this.render(); this.updateButtons();
    }

    // ── Modal ────────────────────────────────────────────────────────────────
    openModal(match, bestOf = 3) {
        if (!match) return;
        this.manualMatchPending = match;
        this.manualMatchPending.bestOf = bestOf;
        const tl  = match.t1?.isManual ? match.t1 : match.t2;
        const opp = match.t1?.isManual ? match.t2 : match.t1;
        document.getElementById('modalMatchup').innerHTML = `
            <div class="modal-team"><img src="${tl?.logo||DEFAULT_LOGO}"><div class="name">${tl?.name||'TL'}</div><div class="elo">ELO ${tl?.rating||0}</div></div>
            <div class="modal-vs">VS</div>
            <div class="modal-team"><img src="${opp?.logo||DEFAULT_LOGO}"><div class="name">${opp?.name||'?'}</div><div class="elo">ELO ${opp?.rating||0}</div></div>`;
        const c = document.getElementById('mapsContainer');
        c.innerHTML = '';
        const maps = bestOf === 5 ? 5 : 3;
        for (let i=1; i<=maps; i++) {
            c.innerHTML += `<div class="map-row"><label>MAP ${i}</label><input type="number" id="m${i}_f" placeholder="?" min="0" max="30" oninput="gi._updatePreview()"><span class="map-sep">—</span><input type="number" id="m${i}_e" placeholder="?" min="0" max="30" oninput="gi._updatePreview()"></div>`;
        }
        document.getElementById('eloPreview').style.display = 'none';
        document.getElementById('manualModal').style.display = 'flex';
    }

    closeModal() {
        this.manualMatchPending = null;
        document.getElementById('manualModal').style.display = 'none';
        this.render(); this.updateButtons();
    }

    _updatePreview() {
        const match = this.manualMatchPending; if (!match) return;
        const tl  = match.t1?.isManual ? match.t1 : match.t2;
        const opp = match.t1?.isManual ? match.t2 : match.t1;
        const bo  = match.bestOf || 3; const wt = Math.ceil(bo/2);
        let wM=0, wE=0;
        for (let i=1; i<=bo; i++) {
            if (wM>=wt||wE>=wt) break;
            const vf=document.getElementById(`m${i}_f`)?.value;
            const ve=document.getElementById(`m${i}_e`)?.value;
            if (!vf||!ve) return;
            const s1=parseInt(vf),s2=parseInt(ve);
            if (isNaN(s1)||isNaN(s2)) return;
            if (s1>s2) wM++; else if (s2>s1) wE++;
        }
        if (wM<wt&&wE<wt) return;
        const won = wM>=wt;
        const K   = giKFactor(this.currentPhase);
        const { gain, loss, chance } = calcElo(tl.rating, opp.rating, K);
        const delta = won?gain:-loss;
        const newElo = Math.max(0, tl.rating+delta);
        const color  = won?'#42f590':'#ff4655';
        document.getElementById('eloPreview').style.display = 'block';
        document.getElementById('eloPreviewText').innerHTML = `ELO: <span style="color:#888">${tl.rating}</span> → <span style="color:${color};font-weight:bold">${newElo}</span> <span style="color:${color}">${delta>0?'+':''}${delta}</span> <span style="color:#333">| Chance: ${chance}%</span>`;
    }

    confirmManualMatch() {
        const match = this.manualMatchPending; if (!match) return;
        const tl  = match.t1?.isManual ? match.t1 : match.t2;
        const opp = match.t1?.isManual ? match.t2 : match.t1;
        const bo  = match.bestOf||3; const wt=Math.ceil(bo/2);
        let wM=0,wE=0; const maps=[];
        for (let i=1; i<=bo; i++) {
            if (wM>=wt||wE>=wt) break;
            const s1=parseInt(document.getElementById(`m${i}_f`)?.value||'');
            const s2=parseInt(document.getElementById(`m${i}_e`)?.value||'');
            if (isNaN(s1)||isNaN(s2)||s1===s2) { alert('Resultado inválido'); return; }
            if (s1>s2) wM++; else wE++;
            maps.push({ sW:Math.max(s1,s2), sL:Math.min(s1,s2), winner:s1>s2?tl:opp });
        }
        if (wM<wt&&wE<wt) { alert('Preencha todos os mapas necessários'); return; }
        const winner=wM>=wt?tl:opp, loser=winner===tl?opp:tl;
        this._resolveStats(winner, loser, `${Math.max(wM,wE)}-${Math.min(wM,wE)}`, maps, match);
        localStorage.removeItem('gi_pending_tl');
        this.manualMatchPending = null;
        document.getElementById('manualModal').style.display = 'none';

        // Avança rodada de grupos se necessário
        if (this.currentPhase === 'GROUPS') {
            const remaining = this.schedule.filter(m=>m.round===this.currentGroupRound&&!m.played).length;
            if (remaining === 0) {
                const maxRound = Math.max(...this.schedule.map(m=>m.round));
                if (this.currentGroupRound < maxRound) this.currentGroupRound++;
                else if (this.schedule.every(m=>m.played)) { this._advanceToKO(); return; }
            }
        }
        this.save(); this.render(); this.updateButtons();
    }

    _checkPending() {
        const p = localStorage.getItem('gi_pending_tl');
        if (!p || !['GROUPS','QUARTERS','SEMIS','FINAL'].includes(this.currentPhase)) return;
        try {
            const { t1, t2, round } = JSON.parse(p);
            let match = null;
            if (this.currentPhase === 'GROUPS') {
                match = this.schedule.find(m => !m.played && m.round===round && ((m.t1?.name===t1&&m.t2?.name===t2)||(m.t1?.name===t2&&m.t2?.name===t1)));
            } else {
                match = this.knockoutMatches.find(m => !m.played && m.phase===this.currentPhase && m.t1 && m.t2 && (m.t1.isManual||m.t2.isManual));
            }
            if (match) { this.manualMatchPending = match; setTimeout(()=>this.openModal(match,match.bestOf||3),300); }
            else localStorage.removeItem('gi_pending_tl');
        } catch(e) { localStorage.removeItem('gi_pending_tl'); }
    }

    // ── Render ───────────────────────────────────────────────────────────────
    render() {
        const display = document.getElementById('mainDisplay');
        const phaseLabel = document.getElementById('phaseLabel');
        const phaseNames = { IDLE:'Aguardando Início', GROUPS:`FASE DE GRUPOS — RODADA ${this.currentGroupRound}/5`, QUARTERS:'QUARTAS DE FINAL', SEMIS:'SEMIFINAL', FINAL:'GRANDE FINAL', FINISHED:'TORNEIO ENCERRADO' };
        phaseLabel.textContent = phaseNames[this.currentPhase] || '';

        // Hero info
        const tlTeam = this.teams.find(t=>t.isManual);
        document.getElementById('heroElo').textContent   = tlTeam?.rating ?? '—';
        document.getElementById('heroPhase').textContent = phaseNames[this.currentPhase] || '—';
        document.getElementById('heroRegion').textContent = 'EMEA';

        if (this.currentPhase === 'IDLE') { display.innerHTML = '<div style="text-align:center;padding:60px;color:var(--muted)">Clique em <strong style="color:var(--gold)">NOVO TORNEIO</strong> para iniciar</div>'; return; }
        if (this.currentPhase === 'FINISHED') { this._renderBracket(display); this._renderLog(); return; }
        if (this.currentPhase === 'GROUPS') { this._renderGroups(display); this._renderLog(); return; }
        this._renderBracket(display); this._renderLog();
    }

    _renderGroups(container) {
        const played = this.schedule.filter(m=>m.played).length;
        const total  = this.schedule.length;
        document.getElementById('progressFill').style.width = (played/total*100)+'%';

        container.innerHTML = '<div class="groups-wrap" id="groupsInner"></div>';
        const inner = document.getElementById('groupsInner');

        ['A','B','C','D'].forEach(g => {
            const allTeams = [...this.groups[g]].sort((a,b)=>b.points-a.points||b.wins-a.wins);
            const groupMatches = this.schedule.filter(m=>m.group===g);
            const pending      = groupMatches.filter(m=>!m.played);
            const playedG      = groupMatches.filter(m=>m.played).length;

            const rows = allTeams.map((tm, pos) => {
                const myPending = pending.filter(m=>m.t1===tm||m.t2===tm);
                const gamesLeft = myPending.length;

                // Monte Carlo classification chance
                let simWins = 0;
                for (let s=0; s<150; s++) {
                    let pts = tm.points;
                    myPending.forEach(m => {
                        const opp = m.t1===tm?m.t2:m.t1;
                        const p = Math.max(5,Math.min(95,100/(1+Math.pow(10,((opp.rating||0)-(tm.rating||0))/400))));
                        if (Math.random()*100<=p) pts+=3;
                    });
                    const others = allTeams.filter(x=>x!==tm).map(x=>{
                        let p=x.points;
                        pending.filter(m=>m.t1===x||m.t2===x).forEach(()=>{if(Math.random()>0.5)p+=3;});
                        return p;
                    });
                    if ([pts,...others].sort((a,b)=>b-a).indexOf(pts)<2) simWins++;
                }
                const qual  = Math.round((simWins/150)*100);
                const qc    = qual>=70?'#42f590':qual>=40?'#ffd700':'#ff4655';

                // Pode perder
                const canLose = myPending.filter(lm => {
                    let ptsIfLose=tm.points;
                    myPending.forEach(m=>{if(m!==lm)ptsIfLose+=3;});
                    const others=allTeams.filter(x=>x!==tm).map(x=>{
                        let p=x.points;
                        pending.filter(m=>m.t1===x||m.t2===x).forEach(m=>{if(m===lm)p+=3;});
                        return p;
                    });
                    return [ptsIfLose,...others].sort((a,b)=>b-a).indexOf(ptsIfLose)<2;
                });
                const mustWin = myPending.filter(m=>!canLose.includes(m));

                // Destino
                const maxPts = tm.points+gamesLeft*3;
                let fate;
                if (gamesLeft===0) {
                    fate = pos<2 ? `<span class="fate-lock">✅ Classificado</span>` : `<span class="fate-elim">❌ Eliminado</span>`;
                } else if (maxPts<6&&allTeams.filter(x=>x!==tm).filter(x=>x.points+(pending.filter(m=>m.t1===x||m.t2===x).length*3)>=6).length>=2) {
                    fate = `<span class="fate-elim">❌ Eliminado</span>`;
                } else if (mustWin.length===0) {
                    fate = `<span class="fate-lock">✅ Garantido</span>`;
                } else {
                    fate = qual>=65?`<span class="fate-direct">🟢 Favorito</span>`:qual>=35?`<span class="fate-open">🟡 Em aberto</span>`:`<span class="fate-risk">🔴 Em risco</span>`;
                }

                const oppName = m => { const o=m.t1===tm?m.t2:m.t1; return `<img src="${o.logo||DEFAULT_LOGO}" style="width:11px;height:11px;object-fit:contain;vertical-align:middle"> ${o.name}`; };
                const scenario = mustWin.length>0 ? `<span style="color:var(--red);font-size:0.65rem">⚠ ${mustWin.map(oppName).join(', ')}</span>` : gamesLeft>0 ? `<span style="color:var(--green);font-size:0.65rem">✓ Seguro</span>` : '—';
                const margin   = gamesLeft===0?'—':canLose.length>0?`<span style="color:var(--muted);font-size:0.63rem">↓ ${canLose.map(oppName).join(', ')}</span>`:`<span style="color:#555;font-size:0.63rem">Nenhuma</span>`;

                const wr = (tm.wins||0)+(tm.losses||0)>0 ? Math.round(((tm.wins||0)/((tm.wins||0)+(tm.losses||0)))*100)+'%' : '—';

                return `<tr class="team-row ${tm.isManual?'manual-row':''} ${tm.qualified?'qualified-row':''}">
                    <td><span class="reg-dot reg-${tm.region}"></span><img src="${tm.logo||DEFAULT_LOGO}" class="team-logo-sm">${tm.name}${tm.qualified?'<span class="qual-badge">✓</span>':''}</td>
                    <td class="pts">${tm.points}</td>
                    <td>${(tm.wins||0)}W/${(tm.losses||0)}L</td>
                    <td><span style="color:${qc};font-family:monospace;font-size:0.75rem">${qual}%</span><span class="chance-bar"><span class="chance-fill" style="width:${qual}%;background:${qc}"></span></span></td>
                    <td>${fate}</td>
                    <td>${scenario}</td>
                    <td>${margin}</td>
                </tr>`;
            }).join('');

            inner.innerHTML += `<div class="group-card">
                <div class="group-header"><h3>GRUPO ${g}</h3><span>${playedG}/${groupMatches.length} jogos</span></div>
                <table>
                    <thead><tr><th>Time</th><th>Pts</th><th>W/L</th><th>Classif.</th><th>Destino</th><th>Cenário</th><th>↓ Pode perder</th></tr></thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
        });
    }

    _renderBracket(container) {
        const renderTeam = (t, won) => {
            if (!t) return `<div class="bracket-team empty-team"><span>...</span></div>`;
            return `<div class="bracket-team ${won?'winner-team':''}"><span class="reg-dot reg-${t.region}"></span><img src="${t.logo||DEFAULT_LOGO}" style="width:16px;height:16px;object-fit:contain"><span>${t.name}</span></div>`;
        };

        const renderMatch = m => {
            const hasTL = m.t1?.isManual||m.t2?.isManual;
            const active = !m.played && m.t1 && m.t2 && m.phase===this.currentPhase;
            return `<div class="bracket-match ${active?'active-match':''} ${hasTL?'has-tl':''}">
                ${renderTeam(m.t1, m.winner===m.t1)}
                ${renderTeam(m.t2, m.winner===m.t2)}
                ${m.played?`<div class="score-row">${m.score}</div>`:''}
            </div>`;
        };

        const phases = ['QUARTERS','SEMIS','FINAL'];
        const cols = phases.map(phase => {
            const matches = this.knockoutMatches.filter(m=>m.phase===phase);
            return `<div class="bracket-col">
                <div class="bracket-col-header">${{QUARTERS:'QUARTAS',SEMIS:'SEMIFINAL',FINAL:'FINAL'}[phase]}</div>
                ${matches.map(renderMatch).join('')}
            </div>`;
        }).join('');

        container.innerHTML = `<div class="bracket-wrap">${cols}</div>`;
        document.getElementById('progressFill').style.width = this.currentPhase==='FINISHED'?'100%':'0%';
    }

    _renderLog() {
        document.getElementById('gameLog').innerHTML = this.historyLogs.slice(0,30).map(l=>
            `<div class="log-entry ${l.tl?'tl-log':''}">${l.text}<div class="log-detail">${l.detail}</div></div>`
        ).join('');
    }

    // ── Buttons ──────────────────────────────────────────────────────────────
    updateButtons() {
        const btn       = document.getElementById('btnPlay');
        const btnReopen = document.getElementById('btnReopenModal');
        btn.disabled    = false; btnReopen.style.display='none';
        if (this.currentPhase==='IDLE')     { btn.disabled=true; btn.textContent='NOVO TORNEIO'; return; }
        if (this.currentPhase==='FINISHED') { btn.disabled=true; btn.textContent='TORNEIO ENCERRADO'; return; }
        if (this.manualMatchPending)        { btn.disabled=true; btn.textContent='⏳ AGUARDANDO RESULTADO TL'; btnReopen.style.display='inline-block'; return; }
        const pendinRound = this.currentPhase==='GROUPS' && this.schedule.filter(m=>m.round===this.currentGroupRound&&!m.played).length===0;
        btn.textContent = pendinRound ? '▶ AVANÇAR RODADA' : '⚔ PRÓXIMA BATALHA';
    }

    // ── Career modal ─────────────────────────────────────────────────────────
    openCareerModal() {
        this.switchCareerTab('overview', document.querySelector('#careerModal button.career-active'));
        document.getElementById('careerModal').style.display='flex';
    }

    switchCareerTab(tab, el) {
        document.querySelectorAll('#careerModal button').forEach(b=>b.classList.remove('career-active','btn-gold'));
        if(el){el.classList.add('career-active');el.style.borderColor='var(--gold)';el.style.color='var(--gold)';}
        const body=document.getElementById('careerBody');
        const m=this.tlStats.matches, wins=m.filter(x=>x.result==='W').length, losses=m.filter(x=>x.result==='L').length;
        const total=wins+losses, wr=total>0?((wins/total)*100).toFixed(1):'—';
        const elo=this.legacyStats['Team Liquid']?.elo??0;
        if(tab==='overview'){
            body.innerHTML=`<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px">
                ${[['ELO',elo,'var(--gold)'],['PEAK',m.length?Math.max(...this.tlStats.eloHistory.map(e=>e.elo)||[0]):elo,'var(--gold2)'],['WR',wr+'%','var(--green)'],['JOGOS',total,'var(--liquid)']].map(([l,v,c])=>
                `<div style="background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:14px;text-align:center"><div style="font-size:1.6rem;font-weight:900;color:${c};font-family:monospace">${v}</div><div style="font-size:0.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px">${l}</div></div>`).join('')}
            </div>`;
        }else if(tab==='history'){
            const rows=[...m].reverse().map(x=>`<tr><td style="color:var(--muted);font-size:0.7rem">${x.date}</td><td style="color:var(--muted);font-size:0.68rem">${x.season||'—'}</td><td><img src="${x.oppLogo||DEFAULT_LOGO}" style="width:14px;height:14px;object-fit:contain;vertical-align:middle;margin-right:4px">${x.opponent}</td><td style="color:${x.result==='W'?'var(--green)':'var(--red)'};font-family:monospace">${x.result==='W'?'WIN':'LOSS'}</td><td style="font-family:monospace;font-size:0.72rem">${x.score}</td><td style="font-family:monospace;color:${x.eloChange>0?'var(--green)':'var(--red)'};font-size:0.72rem">${x.eloChange>0?'+':''}${x.eloChange}</td></tr>`).join('');
            body.innerHTML=`<table style="width:100%;border-collapse:collapse;font-size:0.78rem"><thead><tr>${['Data','Torneio','Oponente','Res','Score','ELO'].map(h=>`<th style="padding:7px;border-bottom:1px solid var(--border);color:var(--muted);font-size:0.62rem;text-align:left;font-weight:normal;text-transform:uppercase;letter-spacing:1px">${h}</th>`).join('')}</tr></thead><tbody>${rows||'<tr><td colspan="6" style="padding:30px;text-align:center;color:var(--muted)">Nenhuma partida ainda</td></tr>'}</tbody></table>`;
        }else{
            const h2h=this.tlStats.headToHead;
            const entries=Object.entries(h2h).map(([name,d])=>({name,...d,total:d.wins+d.losses,wr:d.wins+d.losses>0?Math.round((d.wins/(d.wins+d.losses))*100):0})).sort((a,b)=>b.total-a.total);
            const rows=entries.map(e=>`<tr><td><img src="${e.logo||DEFAULT_LOGO}" style="width:16px;height:16px;object-fit:contain;vertical-align:middle;margin-right:5px">${e.name}</td><td style="color:var(--green);font-family:monospace">${e.wins}W</td><td style="color:var(--red);font-family:monospace">${e.losses}L</td><td style="font-family:monospace;font-weight:bold;color:${e.wr>=50?'var(--green)':'var(--red)'}">${e.wr}%</td></tr>`).join('');
            body.innerHTML=`<table style="width:100%;border-collapse:collapse;font-size:0.78rem"><thead><tr>${['Time','Vitórias','Derrotas','WR'].map(h=>`<th style="padding:7px;border-bottom:1px solid var(--border);color:var(--muted);font-size:0.62rem;text-align:left;font-weight:normal;text-transform:uppercase;letter-spacing:1px">${h}</th>`).join('')}</tr></thead><tbody>${rows||'<tr><td colspan="4" style="padding:30px;text-align:center;color:var(--muted)">Nenhum confronto ainda</td></tr>'}</tbody></table>`;
        }
    }

    wipe() {
        if (!confirm('Apagar o Global Invitational atual?\nO ELO global e a carreira da TL são preservados.')) return;
        DB.remove(GI_KEY);
        localStorage.removeItem('gi_pending_tl');
        this.teams=[]; this.groups={}; this.schedule=[]; this.knockoutMatches=[];
        this.currentPhase='IDLE'; this.historyLogs=[]; this.manualMatchPending=null;
        this.render(); this.updateButtons();
    }
}

// ─── Boot ────────────────────────────────────────────────────────────────────
let gi;

function _init() {
    if (typeof DB === 'undefined') { document.addEventListener('db-ready', _init, { once:true }); return; }
    DB.init().then(() => {
        gi = new GlobalInvitational();
        gi.render();
        gi.updateButtons();
        gi._checkPending();
        const ov = document.getElementById('loadingOverlay');
        if (ov) { ov.style.opacity='0'; setTimeout(()=>ov.remove(),400); }
    });
}
_init();
</script>
</body>
</html>
